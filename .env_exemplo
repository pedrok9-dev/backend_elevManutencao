# ============================================================================
# VARIÁVEIS DE AMBIENTE — RAILWAY
# ============================================================================
# Este arquivo é só um MODELO. No Railway você NÃO edita um arquivo .env —
# você cola essas variáveis na aba "Variables" do serviço do backend.
#
# 🔧 PASSO A PASSO:
# 1) No projeto do Railway, clique em "+ New" -> "Database" -> "Add MySQL"
#    (se ainda não tiver um banco).
# 2) Vá no serviço do BACKEND -> aba "Variables" -> "+ New Variable" ->
#    "Add Reference" -> escolha o serviço MySQL -> selecione DATABASE_URL.
#    O Railway cria algo assim automaticamente (você não digita na mão):
#    DATABASE_URL=${{MySQL.DATABASE_URL}}
# 3) Ainda na aba "Variables" do backend, adicione manualmente as de baixo:
# ============================================================================

NODE_ENV=production
PORT=3000

# 🔧 TROQUE por uma frase longa e aleatória (pode gerar em https://randomkeygen.com)
JWT_SECRET=troque_esta_chave_por_uma_bem_grande_e_aleatoria
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10

# 🔧 Depois que o FRONTEND estiver publicado, troque o "*" pela URL dele
# (ex: https://elevmanutencao-frontend.up.railway.app) para deixar mais seguro.
CORS_ORIGIN=*